{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Protein Ensemble Package Manifest",
  "description": "Data contract for Protein Ensemble packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "content_hash",
    "topology_reference",
    "members"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "The current manifest schema version."
    },
    "id": {
      "type": "string",
      "description": "Unique ensemble ID."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+:[a-fA-F0-9]+$",
      "description": "Content hash in the format algorithm:hexdigest."
    },
    "topology_reference": {
      "type": "object",
      "description": "Identifies the topology against which ensemble members are interpreted.",
      "oneOf": [
        {
          "required": ["member_id"],
          "properties": {
            "member_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["external_reference"],
          "properties": {
            "external_reference": {
              "type": "object",
              "required": ["uri"],
              "properties": {
                "uri": {
                  "type": "string",
                  "format": "uri-reference"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "weight_scheme": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "equilibrium_probability",
            "cluster_fraction",
            "experimental_occupancy",
            "uniform",
            "custom"
          ]
        },
        "normalized": {
          "type": "boolean"
        },
        "custom_semantics": {}
      },
      "if": {
        "properties": {
          "type": {
            "const": "custom"
          }
        }
      },
      "then": {
        "required": ["custom_semantics"]
      }
    },
    "capabilities_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["standalone_cif"]
    },
    "metadata": {
      "type": "object",
      "description": "Opaque passthrough for metadata."
    },
    "dynamics": {
      "type": "object",
      "description": "Opaque passthrough for dynamics."
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "structure"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Unique member ID matching alphanumeric, hyphen, and underscore characters."
          },
          "structure": {
            "type": "object",
            "oneOf": [
              {
                "title": "Standalone",
                "required": ["uri"],
                "properties": {
                  "uri": {
                    "type": "string",
                    "format": "uri-reference"
                  }
                },
                "additionalProperties": false
              },
              {
                "title": "Multi-model",
                "required": ["uri", "model_index"],
                "properties": {
                  "uri": {
                    "type": "string",
                    "format": "uri-reference"
                  },
                  "model_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              {
                "title": "Trajectory-backed",
                "required": [
                  "topology_uri",
                  "trajectory_uri",
                  "frame_index",
                  "trajectory_format"
                ],
                "properties": {
                  "topology_uri": {
                    "type": "string",
                    "format": "uri-reference"
                  },
                  "trajectory_uri": {
                    "type": "string",
                    "format": "uri-reference"
                  },
                  "frame_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "trajectory_format": {
                    "type": "string",
                    "enum": ["xtc", "dcd", "trr", "nc"]
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "weight": {
            "type": "object",
            "required": ["value"],
            "properties": {
              "value": {
                "type": "number"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "residue_mapping": {
            "type": "object",
            "required": ["uri"],
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri-reference"
              },
              "format": {
                "type": "string"
              }
            }
          },
          "thermodynamics": {
            "type": "object",
            "description": "Opaque passthrough for thermodynamics."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
